# Server secrets and settings for the Deadly Drops stack. On each server this file is
# /root/deadly-drops/.env (chmod 600). Never commit the real one.
#
# Docker Compose reads it on every run in /root/deadly-drops (deploys, backups, by hand) to pick the
# compose file and fill ${...} in it; the compose file passes only the variables the app needs into
# the web container. Compose expands $ in unquoted values, so wrap any value containing $ in single
# quotes. DATABASE_URL, CONTENT_DIR and DOWNLOADS_DIR (the desktop app's downloads, dedicated server
# only) are set by the compose file; leave them out.

# Which server this is. The dedicated server (ddptournaments.com, its own Caddy for HTTPS) sets the
# three lines below. The old shared server (ddptournament.com, behind the shared proxy) sets none of
# them, so Compose uses docker-compose.yml and the site URL defaults to https://ddptournament.com.
#
# COMPOSE_FILE: the compose file every `docker compose` here uses, so never pass -f.
COMPOSE_FILE=docker-compose.standalone.yml
# SITE_DOMAIN: the bare domain Caddy serves and gets certificates for (www.<domain> redirects to it).
SITE_DOMAIN=ddptournaments.com
# SITE_URL: the public address baked into the build (links, sitemap, share cards): a plain https
# origin on SITE_DOMAIN, no path, no trailing slash. server-steps.sh reads it here and builds with
# NEXT_PUBLIC_SITE_URL set from it, so don't set NEXT_PUBLIC_SITE_URL yourself (a hand-run
# `docker compose build` falls back to https://$SITE_DOMAIN). A change needs a deploy, not a restart.
SITE_URL=https://ddptournaments.com

# Owner login for /admin. Run `npm run admin:setup` locally and copy the values
# from web/.env.local (that file writes each $ as \$: remove the backslashes).
ADMIN_EMAIL=
# single quotes keep the $ signs literal: ADMIN_PASSWORD_HASH='scrypt$<salt>$<hash>'
ADMIN_PASSWORD_HASH=
# Staff logins are created in the admin (Staff). To sign someone out everywhere,
# disable their login there; a new owner password signs the owner out everywhere.

# Database password. Letters and digits only: it goes into DATABASE_URL unescaped.
# e.g. `openssl rand -hex 24`. Set it before the first start: PostgreSQL stores it
# when it creates the data volume, and changing it here later does not change it there.
POSTGRES_PASSWORD=

# Dedicated server only. The desktop app's activation codes are stored keyed with this (HMAC-SHA256):
# 64 hex characters. Leave it empty: server-steps.sh fills it in on the next deploy (`openssl rand -hex 32`)
# and never prints it. Keep it after that: a new value voids the codes not used yet (activated copies keep
# working). The app refuses to make or accept codes without it.
DESKTOP_CODE_SECRET=
