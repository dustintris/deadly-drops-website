# Server secrets for the Deadly Drops stack. On the VPS this file is
# /root/deadly-drops/.env (chmod 600). Never commit the real one.
#
# Docker Compose reads it to fill ${...} in docker-compose.yml, which passes only
# the variables the app needs into the web container. Compose expands $ in
# unquoted values, so wrap any value containing $ in single quotes.
# DATABASE_URL and CONTENT_DIR are set by docker-compose.yml; leave them out.
# The public site URL is baked in at build time: pass SITE_URL to deploy.sh.

# Owner login for /admin. Run `npm run admin:setup` locally and copy the values
# from web/.env.local (that file writes each $ as \$: remove the backslashes).
ADMIN_EMAIL=
# single quotes keep the $ signs literal: ADMIN_PASSWORD_HASH='scrypt$<salt>$<hash>'
ADMIN_PASSWORD_HASH=
# at least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# raise to sign every admin session out
ADMIN_SESSION_VERSION=1

# Database password. Letters and digits only: it goes into DATABASE_URL unescaped.
# e.g. `openssl rand -hex 24`. Set it before the first start: PostgreSQL stores it
# when it creates the data volume, and changing it here later does not change it there.
POSTGRES_PASSWORD=
