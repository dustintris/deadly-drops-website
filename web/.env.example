# Copy to .env.local (never commit it). `npm run admin:setup` fills in the first three for you.
ADMIN_EMAIL=owner@example.com
# scrypt hash from `npm run admin:setup` (the $ signs are escaped as \$)
ADMIN_PASSWORD_HASH=
# at least 32 random characters
SESSION_SECRET=
# raise to sign every admin session out
ADMIN_SESSION_VERSION=1
# where drafts, published content, history, uploads and the audit log are stored (a persistent disk in production)
CONTENT_DIR=
# canonical site URL for share links and the sitemap
NEXT_PUBLIC_SITE_URL=https://deadlydropspickleball.com
# serve under a sub-path, e.g. /club
NEXT_PUBLIC_BASE_PATH=
